# Example nginx site for dropeat.techlapse.co.in
# Copy to /etc/nginx/sites-available/dropeat and symlink sites-enabled.
#
# Prerequisite: Node API listening on 127.0.0.1:8000 (pm2 or systemd).

upstream dropeat_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name dropeat.techlapse.co.in;

    # ssl_certificate /etc/letsencrypt/live/dropeat.techlapse.co.in/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/dropeat.techlapse.co.in/privkey.pem;

    client_max_body_size 50m;

    location /api/ {
        proxy_pass http://dropeat_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Socket.IO — required for admin dashboard + apps
    location /socket.io/ {
        proxy_pass http://dropeat_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /upload/ {
        proxy_pass http://dropeat_api;
        proxy_set_header Host $host;
    }
}
